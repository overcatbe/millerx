msgstr "Έγινε επαναφορά στην τελευταία υποβολή"

#: src/git.c:393
msgid "Couldn't add to Git"
msgstr "Δεν ήταν δυνατή η προσθήκη στο Git"

#: src/git.c:394
#, c-format
