# Maintainer: overcatbe <1771834+overcatbe@users.noreply.github.com>
pkgname=millerx
pkgver=0.5.4
pkgrel=1
pkgdesc="Small native file browser with Miller columns (GTK 3)"
arch=('x86_64' 'aarch64')
url="https://github.com/overcatbe/millerx"
license=('GPL-2.0-or-later')
depends=('gtk3' 'glib2' 'libarchive' 'hicolor-icon-theme')
makedepends=('meson' 'ninja')
optdepends=('poppler: PDF preview (pdftoppm)'
            'polkit: "Open as root" (needs a polkit authentication agent)')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  arch-meson "$pkgname-$pkgver" build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
