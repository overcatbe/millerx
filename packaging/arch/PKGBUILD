# Maintainer: overcatbe <1771834+overcatbe@users.noreply.github.com>
# Contributor: Claude (Anthropic)
pkgname=millerx
pkgver=0.7.9
pkgrel=1
pkgdesc="Small native file browser with Miller columns (GTK 3)"
arch=('x86_64' 'aarch64')
url="https://github.com/overcatbe/millerx"
license=('GPL-2.0-or-later')
depends=('gtk3' 'glib2' 'libarchive' 'libwebp' 'hicolor-icon-theme')
makedepends=('meson' 'ninja' 'gettext')
options=('!debug')
optdepends=('poppler: PDF preview (pdftoppm)'
            'ffmpeg: AVIF, HEIC and other pictures gdk-pixbuf cannot read'
            'polkit: "Open as root" (needs a polkit authentication agent)')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  arch-meson "$pkgname-$pkgver" build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
